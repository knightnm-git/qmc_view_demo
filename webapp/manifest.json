{
  "_version": "1.81.0",
  "sap.app": {
    "id": "cos.qmc.views.qmcviewdemo",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.1",
      "toolsId": "8759f08f-7e02-4c92-bef6-28dccbbb3911"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.143.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cos.qmc.views.qmcviewdemo.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "cos.qmc.views.qmcviewdemo.view",
        "async": true,
        "viewPath": "cos.qmc.views.qmcviewdemo.view"
      },
      "routes": [
        {
          "name": "RouteMainView",
          "pattern": ":?query:",
          "target": [
            "TargetMainView"
          ]
        },
        { "name": "RouteView1", "pattern": "view1", "target": ["TargetView1"] },
    { "name": "RouteView2", "pattern": "view2", "target": ["TargetView2"] }
      ],
      "targets": {
        "TargetMainView": {
          "id": "MainView",
          "name": "MainView"
        },
        "TargetView1": { "viewName": "View1", "viewId": "View1" },
    "TargetView2": { "viewName": "View2", "viewId": "View2" }
      }
    },
    "rootView": {
      "viewName": "cos.qmc.views.qmcviewdemo.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
