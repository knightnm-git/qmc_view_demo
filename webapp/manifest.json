{
  "_version": "1.81.0",
  "sap.app": {
    "id": "cos.qmc.views.qmcviewdemo",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.1",
      "toolsId": "8759f08f-7e02-4c92-bef6-28dccbbb3911"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/COS/CMDS_QMC1_SRV",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.143.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.uxap": {},
        "sap.ui.table": {},
        "sap.ui.comp": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cos.qmc.views.qmcviewdemo.i18n.i18n"
        }
      },
      "headerDetail": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false,
          "metadataUrlParams": {
            "sap-value-list": "all"
          }
        }
      },
      "": {
    "dataSource": "mainService",
    "settings": {
      "metadataUrlParams": {
        "sap-value-list": "all"
      }
    }
  }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "cos.qmc.views.qmcviewdemo.view",
        "async": true,
        "viewPath": "cos.qmc.views.qmcviewdemo.view"
      },
      "routes": [
        {
          "name": "RouteMainView",
          "pattern": ":?query:",
          "target": [
            "TargetMainView"
          ]
        },
        {
          "name": "RouteView1",
          "pattern": "view1",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "RouteView2",
          "pattern": "view2",
          "target": [
            "TargetView2"
          ]
        },
        {
          "name": "RouteView3",
          "pattern": "view3",
          "target": [
            "TargetView3"
          ]
        },
        {
          "name": "RouteView4",
          "pattern": "view4",
          "target": [
            "TargetView4"
          ]
        },
        {
          "name": "RouteView5",
          "pattern": "view5",
          "target": [
            "TargetView5"
          ]
        },
        {
          "name": "RouteView6",
          "pattern": "view6",
          "target": [
            "TargetView6"
          ]
        },
        {
          "name": "RouteView7",
          "pattern": "view7",
          "target": [
            "TargetView7"
          ]
        }
      ],
      "targets": {
        "TargetMainView": {
          "id": "MainView",
          "name": "MainView"
        },
        "TargetView1": {
          "viewName": "View1",
          "viewId": "View1"
        },
        "TargetView2": {
          "viewName": "View2",
          "viewId": "View2"
        },
        "TargetView3": {
          "viewName": "View3",
          "viewId": "View3"
        },
        "TargetView4": {
          "viewName": "View4",
          "viewId": "View4"
        },
        "TargetView5": {
          "viewName": "View5",
          "viewId": "View5"
        },
        "TargetView6": {
          "viewName": "View6",
          "viewId": "View6"
        },
        "TargetView7": {
          "viewName": "View7",
          "viewId": "View7"
        }
      }
    },
    "rootView": {
      "viewName": "cos.qmc.views.qmcviewdemo.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}

