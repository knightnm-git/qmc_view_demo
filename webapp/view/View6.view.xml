<mvc:View 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:smartForm="sap.ui.comp.smartform"
    height="100%"
    controllerName="cos.qmc.views.qmcviewdemo.controller.View6">
    
    <ObjectPageLayout id="ObjectPageLayout6" showTitleInHeaderContent="true" upperCaseAnchorBar="false" showFooter="true">

        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="Cosol - Quick Material Create - View 6" wrapping="true"/>
                </expandedHeading>
                <snappedHeading>
                    <m:Title text="Cosol - Quick Material Create - View 6" wrapping="true"/>
                </snappedHeading>
                    <navigationActions>
                        <m:Button 
                          icon="sap-icon://nav-back" 
                          type="Transparent" 
                          press="onNavBack" 
                          tooltip="Back"/>
                    </navigationActions>
                <actions>
                    <m:Button text="Refresh/Select Data" icon="sap-icon://refresh" type="Emphasized" press="onRefresh" />
                     
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

<headerContent>
    <m:VBox width="450px" class="sapUiNoContentPadding">
        <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <m:Label text="Template Material" width="150px" labelFor="materialInput6" />
            <m:Input
                id="materialInput6"
                value="{/Material}"
                placeholder="Select Material..."
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelpRequest"
                change=".onMaterialChange" />
                <m:Text text='Using Select Dialog'></m:Text>  
        </m:HBox>

        <m:HBox alignItems="Center">
            <m:Label text="Test Run" width="150px" />
            <m:Switch state="{/TestRunActive}" customTextOn="Yes" customTextOff="No" />
        </m:HBox>
    </m:VBox>
</headerContent>


        <sections>
            <ObjectPageSection title="Header/Client Data (normal Form 2 columns)">
          
        <subSections>
            <ObjectPageSubSection >

            <l:Grid defaultSpan="L6 M6 S12" vSpacing="0" hSpacing="0">
        <l:content>
            
            <m:VBox>
                <m:items>
                    
                    
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Material" width="140px" textAlign="Begin" />
                        <m:Text text="generated on save" width="100%" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Description" width="140px" textAlign="Begin" />
                        <m:Input value="{/field2}" placeholder="provide a description...." width="240px" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Material Type" width="140px" textAlign="Begin" />
                        <m:Text text="{/MatType}" width="100%" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Material Group" width="140px" textAlign="Begin" />
                        <m:Input value="{/MatGroup}" width="80px" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="PC" width="140px" textAlign="Begin" />
                        <m:Input value="{/BaseUnit}" width="50px" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Gross Weight" width="140px" textAlign="Begin" />
                        <m:Input value="{/GrossWeight}" width="100px" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Net Weight" width="140px" textAlign="Begin" />
                        <m:Input value="{/NetWeight}" width="100px" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Weight Unit" width="140px" textAlign="Begin" />
                        <m:Input value="{/WeightUnit}" width="50px" />
                    </m:HBox>
                </m:items>
            </m:VBox>

            <m:VBox>
                <m:items>
                  
                    
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Manufacturer" width="140px" textAlign="Begin" />
                        <m:Input value="{/Manufacturer}" width="90px" />
                    </m:HBox>
                    <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <m:Label text="Mfr Part Number" width="140px" textAlign="Begin" />
                        <m:Input value="{/ManufPartNo}" width="110px" />
                    </m:HBox>
                    
                </m:items>
            </m:VBox>

        </l:content>
    </l:Grid>
                
            </ObjectPageSubSection>
        </subSections>
    
            </ObjectPageSection>

            <ObjectPageSection title="Plant Data (Responsive Table)">
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <m:Table id="itemsTable6.1" items="{/to_Plants/results}">
                                <m:columns>
                                    <m:Column><m:Text text="Create for Plant" /></m:Column>
                                    <m:Column><m:Text text="Plant" /></m:Column>
                                    <m:Column><m:Text text="MRP Type" /></m:Column>
                                    <m:Column><m:Text text="Lot Sizing" /></m:Column>
                                    <m:Column><m:Text text="MRP Ctrlr" /></m:Column>
                                    <m:Column><m:Text text="ST ExtProc" /></m:Column>
                                    <m:Column><m:Text text="Storage Bin" /></m:Column>

                                </m:columns>
                            <m:items>
                        <m:ColumnListItem>
                            <m:cells>
                                <m:CheckBox id="CreateForPlant6" selected="true" />
                                <m:Text text="{Plant}" />
                                <m:Text text="{MRPType}" />
                                <m:Input value="{LotSize}" width="3rem" />
                                <m:Input value="{MRPCtrl}" width="4rem" />
                                <m:Input  value="{StrLocExtProc}"/>
                                <m:Input  value="" placeholder="Enter Bin..."/>
                            </m:cells>
                        </m:ColumnListItem>

                     

                    </m:items>
                            </m:Table>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
                        <ObjectPageSection title="Valuation Data (Responsive Table)">
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>

                            <m:Table items="{/to_Valuation/results}" id="itemsTable6.2" sticky="HeaderToolbar,ColumnHeaders">
                                <m:columns>
                                    <m:Column><m:Text text="ValA" /></m:Column>
                                    <m:Column><m:Text text="Val. Type" /></m:Column>
                                    <m:Column><m:Text text="Pr." /></m:Column>
                                    <m:Column><m:Text text="MvAvgPrice" /></m:Column>
                                    <m:Column><m:Text text="Std Price" /></m:Column>
                                    <m:Column><m:Text text="Currency" /></m:Column>

                                    <m:Column minScreenWidth="Tablet" demandPopin="true"><m:Text text="Pr Unit" /></m:Column>
                                    <m:Column minScreenWidth="Tablet" demandPopin="true"><m:Text text="ValCl" /></m:Column>
                                    <m:Column minScreenWidth="Tablet" demandPopin="true"><m:Text text="ValCat" /></m:Column>
                            </m:columns>

                    <m:items>
                        <m:ColumnListItem>
                            <m:cells>
                                 
                                <m:Text text="{ValArea}" />
                                <m:Text text="{ValType}" width="10rem" />
                                <m:Text text="{Prc_Control}" width="3rem" />
                                <m:Input value="{MovAvgPrice}" width="6rem"  />
                                <m:Input value="{StdPrice}" width="6rem"/>
                                <m:Text text="{Currency}" width="3rem" />
                                <m:Input value="{PriceUnit}" width="1rem"/>
                                <m:Input value="{ValClass}" width="5rem"/>
                                <m:Text text="{ValCat}" width="3rem" />
                                
                            </m:cells>
                        </m:ColumnListItem>
                                           
                    </m:items>
                </m:Table>

                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
<footer>
        <m:OverflowToolbar>
            <m:ToolbarSpacer />
            <m:Button type="Emphasized" text="Create New Material" press="onSave" icon="sap-icon://create"/>
            <m:Button text="Cancel" press="onCancel" />
        </m:OverflowToolbar>
    </footer>
    </ObjectPageLayout>

  
</mvc:View>