<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    height="100%"
    controllerName="cos.qmc.views.qmcviewdemo.controller.View2"
>
    <ObjectPageLayout
        id="ObjectPageLayout2"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false"
        showFooter="true"
    >
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title
                        text="Cosol - Quick Material Create - View 2"
                        wrapping="true"
                    />
                </expandedHeading>
                <snappedHeading>
                    <m:Title
                        text="Cosol - Quick Material Create"
                        wrapping="true"
                    />
                </snappedHeading>
                <navigationActions>
                    <m:Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                        tooltip="Back"
                    />
                </navigationActions>
                <actions>
                    <m:Button
                        text="Refresh/Select Data"
                        icon="sap-icon://refresh"
                        type="Emphasized"
                        press="onRefresh"
                    />
                    
		            <m:Button id="button" text="Settings Menu" press="onPress" ariaHasPopup="Menu" visible="false"/>
	
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

        <headerContent>
            <m:VBox>
                <m:Text text="This View has just a hard coded select list of 3 possible materials"/>
                
                <m:Text text="The rest of the view uses an Object Page Layout with a normal 3 column form for the header"/>        
                <m:Text text="and a grid table for the plants and valuation data"/>        
                <m:Text text="binding in error and needs to be fixed"/> 
                <m:ObjectStatus text="View InActive" state="Error" />
                <m:Text text=" " />
            </m:VBox>
            <m:VBox width="450px" class="sapUiNoContentPadding">
                <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <m:Label text="Template Material" width="150px" />
                    <m:Select id="product2" selectedKey="{Product}" width="240px">
                        <m:items>
                            <core:Item key="R-302" text="Material R-302"/>
                            <core:Item key="T_REPAIRABLE" text="Material T_REPAIRABLE"/>
                            <core:Item key="R-311" text="Material R-311"/>
                        </m:items>
                    </m:Select>
                </m:HBox>

                <m:HBox alignItems="Center">
                    <m:Label text="Test Run" width="150px"/>
                    <m:Switch state="true" customTextOn="Yes" customTextOff="No"/>
                </m:HBox>
            </m:VBox>
        </headerContent>

        <sections>
            <ObjectPageSection title="Header/Client Data">
                <subSections>
                    <ObjectPageSubSection>
                        <l:Grid defaultSpan="L4 M4 S12" vSpacing="0" hSpacing="0">
                            <l:content>
                                <m:VBox>
                                    <m:items>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Material"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Text
                                                text="generated on save"
                                                width="100%"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Description"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value=""
                                                placeholder="provide a description...."
                                                width="240px"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Material Type"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Text
                                                text="{demo>/demoClient/MatType}"
                                                width="100%"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Material Group"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/MatGrp}"
                                                width="80px"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Base Unit"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/BaseUnit}"
                                                width="50px"
                                            />
                                        </m:HBox>
                                    </m:items>
                                </m:VBox>

                                <m:VBox>
                                    <m:items>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Gross Weight"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/GrossWeight}"
                                                width="100px"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Net Weight"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/NetWeight}"
                                                width="100px"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Unit of Weight"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/WightUnit}"
                                                width="50px"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Manufacturer"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/Manuf}"
                                                width="90px"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Mfr Part Number"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="{demo>/demoClient/MfrPartNumb}"
                                                width="110px"
                                            />
                                        </m:HBox>
                                    </m:items>
                                </m:VBox>

                                <m:VBox>
                                    <m:items>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Label 11"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="Value 11"
                                                width="100%"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Label 12"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="Value 12"
                                                width="100%"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Label 13"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="Value 13"
                                                width="100%"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Label 14"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="Value 14"
                                                width="100%"
                                            />
                                        </m:HBox>
                                        <m:HBox
                                            alignItems="Center"
                                            class="sapUiTinyMarginBottom"
                                        >
                                            <m:Label
                                                text="Label 15"
                                                width="140px"
                                                textAlign="Begin"
                                            />
                                            <m:Input
                                                value="Value 15"
                                                width="100%"
                                            />
                                        </m:HBox>
                                    </m:items>
                                </m:VBox>
                            </l:content>
                        </l:Grid>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>

            <ObjectPageSection title="Plant Data">
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <t:Table
                                id="itemsTable2.1"
                                rows="{demo>/demoPlants}"
                                columnHeaderHeight="30"
                                selectionMode="None"
                                alternateRowColors="true"
                                enableSelectAll="false"
                            >
                                <t:columns>
                                    <t:Column width="8rem">
                                        <m:Label text="Create for Plant" />
                                        <t:template>
                                            <m:CheckBox selected="true" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="6rem">
                                        <m:Label text="Plant" />
                                        <t:template>
                                            <m:Text text="{demo>PlantID}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="6rem">
                                        <m:Label text="MRP Type" />
                                        <t:template>
                                            <m:Input value="{demo>MrpType}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="6rem">
                                        <m:Label text="Lot Sizing" />
                                        <t:template>
                                            <m:Input value="{demo>LotSize}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="7rem">
                                        <m:Label text="ST ExtProc" />
                                        <t:template>
                                            <m:Input value="{demo>StExtProc}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="10rem">
                                        <m:Label text="Storage Bin" />
                                        <t:template>
                                            <m:Input
                                                value="{demo>StorageBin}"
                                                placeholder="Enter Bin..."
                                            />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="5rem">
                                        <m:Label text="Critical" />
                                        <t:template>
                                            <m:CheckBox
                                                selected="{demo>isCritical}"
                                            />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="5rem">
                                        <m:Label text="PDT" />
                                        <t:template>
                                            <m:Text text="{demo>PdtValue}" />
                                        </t:template>
                                    </t:Column>
                                </t:columns>
                            </t:Table>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
            <ObjectPageSection title="Valuation Data">
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <t:Table id="itemsTableValuation" rows="{/to_Valuation/results}"
                                     selectionMode="None" alternateRowColors="true">
                                <t:columns>
                                    <t:Column width="6rem">
                                        <m:Label text="ValA" />
                                        <t:template>
                                            <m:Text text="{ValArea}" wrapping="false" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="7rem">
                                        <m:Label text="Val. Type" />
                                        <t:template>
                                            <m:Text text="{ValType}" wrapping="false" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="4rem">
                                        <m:Label text="Pr." />
                                        <t:template>
                                            <m:Text text="{PrTyp}" wrapping="false" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="8rem">
                                        <m:Label text="MvAvgPrice" />
                                        <t:template>
                                            <m:Text text="{MvAvgPrice}" wrapping="false" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="8rem">
                                        <m:Label text="Std Price" />
                                        <t:template>
                                            <m:Input value="{StdPrice}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="5rem">
                                        <m:Label text="Pr Unit" />
                                        <t:template>
                                            <m:Input value="{PrUnit}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="7rem">
                                        <m:Label text="ValCl" />
                                        <t:template>
                                            <m:Input value="{ValClass}" />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="6rem">
                                        <m:Label text="ValCat" />
                                        <t:template>
                                            <m:Text text="{ValCat}" wrapping="false" />
                                        </t:template>
                                    </t:Column>
                                </t:columns>
                            </t:Table>

                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
        <footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <m:Button
                    type="Emphasized"
                    text="Create New Material"
                    press="onSave"
                    icon="sap-icon://create"
                />
                <m:Button
                    text="Cancel"
                    press="onCancel"
                />
            </m:OverflowToolbar>
        </footer>
    </ObjectPageLayout>
</mvc:View>
