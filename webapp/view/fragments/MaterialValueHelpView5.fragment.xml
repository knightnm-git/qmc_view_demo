<core:FragmentDefinition
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <ValueHelpDialog
        title="Select Material"
        ok=".onValueHelpOk"
        cancel=".onValueHelpClose"
        key="Material"
        descriptionKey="Material_Text"
        id="materialValueHelpDialog5"
        supportMultiselect="false">
        <filterBar>
            <fb:FilterBar advancedMode="true" search=".onFilterBarSearch">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="__BAR" name="Material" label="Material" visibleInFilterBar="true">
                        <fb:control><m:Input name="Material" /></fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__BAR" name="Material_Text" label="Description" visibleInFilterBar="true">
                        <fb:control><m:Input name="MaterialName" /></fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__BAR" name="MaterialType" label="Material Type" visibleInFilterBar="true">
                        <fb:control><m:Input name="MaterialType" /></fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>
    </ValueHelpDialog>
</core:FragmentDefinition>