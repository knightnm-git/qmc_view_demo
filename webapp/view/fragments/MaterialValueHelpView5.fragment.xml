<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        title="Select Material"
        search=".onValueHelpSearch"
        confirm=".onValueHelpClose"
        cancel=".onValueHelpClose"
        items="{path: '/I_MaterialVH'}" >
        <StandardListItem
            title="{Material}"
            description="{Material_Text}"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>