<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <TableSelectDialog
        id="materialSelectDialog7"
        title="Select Material"
        contentWidth="60%"
        search=".onValueHelpSearch"
        confirm=".onValueConfirm"
        cancel=".onValueHelpClose"
        items="{
            path: 'headerDetail>/I_MaterialVH',
            sorter: { path: 'Material', descending: false }
        }"
        growing="true"
        growingThreshold="20">
        
        <columns>
            <m:Column xmlns:m="sap.m">
                <m:header><m:Text text="Material Number" /></m:header>
            </m:Column>
            <m:Column xmlns:m="sap.m">
                <m:header><m:Text text="Description" /></m:header>
            </m:Column>
            <m:Column xmlns:m="sap.m" minScreenWidth="Tablet" demandPopin="true">
                <m:header><m:Text text="Type" /></m:header>
            </m:Column>
        </columns>

        <ColumnListItem>
            <cells>
                <Text text="{headerDetail>Material}" />
                <Text text="{headerDetail>Material_Text}" />
                <Text text="{headerDetail>MaterialType}" />
            </cells>
        </ColumnListItem>
        
    </TableSelectDialog>
</core:FragmentDefinition>