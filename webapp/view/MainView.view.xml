    xmlns="sap.m">
 
    <Page title="View Selector">
        <content>
            <VBox class="sapUiSmallMargin">
                <Button text="View 1 - Inactive" press="onGoToList"/>
                <Button text="View 2 - Inactive" press="onGoToObject"/>
                <Button text="View 3 - Metadata driven Smart Controls" press="onGoToView3"/>
                <Button text="View 4 - Inactive" press="onGoToView4"/>
                <Button text="View 5 - VH Dialog" press="onGoToView5"/>
                <Button text="View 6 - VH Std List Item" press="onGoToView6"/>
                <Button text="View 7 - VH Tbl Sel Dialog, Auto refresh" press="onGoToView7"  type="Emphasized"/>
            </VBox>
        </content>
    </Page>
</mvc:View>