<mvc:View 
    controllerName="cos.qmc.views.qmcviewdemo.controller.View3"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    height="100%">

    <m:Page id="page" title="Material Master Explorer">
        <m:content>
            <smartFilterBar:SmartFilterBar 
                id="smartFilterBar" 
                entitySet="xCOSxqmc_i_MatHdr" 
                persistencyKey="PKeyMaterialSearch" 
                search="onSearch">
                <smartFilterBar:controlConfiguration>
                    <smartFilterBar:ControlConfiguration 
                        key="Material" 
                        visibleInAdvancedArea="true" 
                        preventInitialDataFetchInValueHelpDialog="true"
                        filterType="single"
                        index="0" />
                </smartFilterBar:controlConfiguration>
            </smartFilterBar:SmartFilterBar>

            <m:IconTabBar id="idIconTabBar" class="sapUiResponsiveContentPadding" expandable="false">
                <m:items>
                    
                    <m:IconTabFilter icon="sap-icon://inventory" text="General Data" key="general">
                        
                            
                        <smartForm:SmartForm 
                            id="smartForm"
                            title="Material Information"
                            flexEnabled="false">
                            
                            <smartForm:Group>
                               
                                
                                <smartForm:GroupElement>
                                    <smartField:SmartField value="{Description}" />
                                </smartForm:GroupElement>
                                
                                <smartForm:GroupElement>
                                    <smartField:SmartField value="{MatType}" />
                                </smartForm:GroupElement>

                                <smartForm:GroupElement>
                                    <smartField:SmartField value="{MatGroup}" />
                                </smartForm:GroupElement>

                                <smartForm:GroupElement>
                                    <smartField:SmartField value="{BaseUOM}" />
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField value="{GrossWeight}" />
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField value="{NetWeight}" />
                                </smartForm:GroupElement>     
                                 <smartForm:GroupElement>
                                    <smartField:SmartField value="{Manufacturer}" />
                                </smartForm:GroupElement>
                                 <smartForm:GroupElement>
                                    <smartField:SmartField value="{ManufPartNo}" />
                                </smartForm:GroupElement>
                                 <smartForm:GroupElement>
                                    <smartField:SmartField value="{BatchMgmtRqt}" />
                                </smartForm:GroupElement>
                                 <smartForm:GroupElement>
                                    <smartField:SmartField value="{Industry}" />
                                </smartForm:GroupElement>                                                           
                            </smartForm:Group>
                            
                        </smartForm:SmartForm>                        
    
    
 
                    </m:IconTabFilter>

                    <m:IconTabFilter icon="sap-icon://factory" text="Plants" key="plants">
                        <smartTable:SmartTable 
    id="plantsTable"
    entitySet="xCOSxqmc_i_matplant" 
    smartFilterId="smartFilterBar"
    header="Plant Details" 
    showRowCount="true"
    enableExport="true"
    initiallyVisibleFields="Plant,MRPType,LotSize,MRPCtrl,StrLocExtProc" />
                    </m:IconTabFilter>

                    <m:IconTabFilter icon="sap-icon://money-bills" text="Valuation" key="valuation">
                        

<smartTable:SmartTable 
    id="valuationTable"
    entitySet="xCOSxQMC_I_MATVAL" 
    smartFilterId="smartFilterBar"
    header="Valuation Details" 
    showRowCount="true"
    enableExport="true"
    initiallyVisibleFields="ValArea,ValType,Prc_Control,MovAvgPrice,StdPrice, PriceUnit,ValClass,ValCat" />
                    </m:IconTabFilter>

                </m:items>
            </m:IconTabBar>
        </m:content>
    </m:Page>
</mvc:View>